  <path d="M250.0 818.0 L512.0 206.0 L774.0 818.0 L634.0 818.0 L512.0 533.0 L390.0 818.0 Z" fill="none" stroke="url(#rim)" stroke-width="4" stroke-linejoin="round"></path>
  <rect x="294" y="644" width="436" height="60" rx="30" fill="#F0744E" opacity=".55" filter="url(#gw)"></rect>
  <rect x="294" y="626" width="436" height="60" rx="30" fill="url(#bar)"></rect>
  <rect x="294" y="626" width="436" height="60" rx="30" fill="url(#barhi)"></rect>
