<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" width="1024" height="1024">
<title>Askesia</title>
<defs>
  <clipPath id="sq"><rect width="1024" height="1024" rx="232"></rect></clipPath>
  <clipPath id="gl"><path d="M250.0 818.0 L512.0 206.0 L774.0 818.0 L634.0 818.0 L512.0 533.0 L390.0 818.0 Z"></path></clipPath>
  <filter id="b1" filterUnits="userSpaceOnUse" x="-600" y="-600" width="2224" height="2224"><feGaussianBlur stdDeviation="170"></feGaussianBlur></filter>
  <filter id="b2" filterUnits="userSpaceOnUse" x="-400" y="-400" width="1824" height="1824"><feGaussianBlur stdDeviation="46"></feGaussianBlur></filter>
  <filter id="sh" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="28"></feGaussianBlur></filter>
  <filter id="gw" x="-60%" y="-200%" width="220%" height="500%"><feGaussianBlur stdDeviation="30"></feGaussianBlur></filter>
  <radialGradient id="o1" gradientUnits="userSpaceOnUse" cx="220" cy="200" r="640"><stop offset="0" stop-color="#9E1749"></stop><stop offset=".45" stop-color="#6A1033" stop-opacity=".75"></stop><stop offset="1" stop-color="#3A0A1C" stop-opacity="0"></stop></radialGradient>
  <radialGradient id="o2" gradientUnits="userSpaceOnUse" cx="860" cy="880" r="620"><stop offset="0" stop-color="#F57A50"></stop><stop offset=".4" stop-color="#D2504F" stop-opacity=".75"></stop><stop offset="1" stop-color="#8E1444" stop-opacity="0"></stop></radialGradient>
  <radialGradient id="o3" gradientUnits="userSpaceOnUse" cx="900" cy="120" r="420"><stop offset="0" stop-color="#2A0712" stop-opacity=".9"></stop><stop offset="1" stop-color="#2A0712" stop-opacity="0"></stop></radialGradient>
  <radialGradient id="i1" gradientUnits="userSpaceOnUse" cx="300" cy="260" r="560"><stop offset="0" stop-color="#E0457A"></stop><stop offset="1" stop-color="#E0457A" stop-opacity="0"></stop></radialGradient>
  <radialGradient id="i2" gradientUnits="userSpaceOnUse" cx="820" cy="860" r="520"><stop offset="0" stop-color="#FFA478"></stop><stop offset="1" stop-color="#FFA478" stop-opacity="0"></stop></radialGradient>
  <linearGradient id="glass" x1="0" y1="0" x2="0.35" y2="1">
    <stop offset="0" stop-color="#fff" stop-opacity=".34"></stop><stop offset=".55" stop-color="#fff" stop-opacity=".10"></stop><stop offset="1" stop-color="#fff" stop-opacity=".09"></stop></linearGradient>
  <linearGradient id="rim" x1="0.2" y1="0" x2="0.8" y2="1">
    <stop offset="0" stop-color="#fff" stop-opacity=".95"></stop><stop offset=".45" stop-color="#fff" stop-opacity=".22"></stop><stop offset="1" stop-color="#ffd7c8" stop-opacity=".55"></stop></linearGradient>
  <linearGradient id="bar" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#B0185A"></stop><stop offset=".55" stop-color="#E2525F"></stop><stop offset="1" stop-color="#F7875A"></stop></linearGradient>
  <linearGradient id="barhi" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#fff" stop-opacity=".55"></stop><stop offset=".5" stop-color="#fff" stop-opacity="0"></stop></linearGradient>
  <linearGradient id="edge" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#fff" stop-opacity=".22"></stop><stop offset=".5" stop-color="#fff" stop-opacity=".03"></stop><stop offset="1" stop-color="#fff" stop-opacity=".10"></stop></linearGradient>
</defs>
<g clip-path="url(#sq)">
  <rect width="1024" height="1024" fill="#13060A"></rect>
