  <path d="M264.0 848.0 L526.0 236.0 L788.0 848.0 L648.0 848.0 L526.0 563.0 L404.0 848.0 Z" fill="#0A0205" opacity=".55" filter="url(#sh)"></path>
  <g clip-path="url(#gl)">
